#!name=Simple AdBlock
#!desc=Простой блокировщик рекламы для Loon
#!author=YourName
#!homepage=https://github.com/yourusername/loon-adblock
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/AdBlocking.png

[General]
force-http-engine-hosts = %APPEND% *.google.com, *.googlevideo.com, *.youtube.com

[Rule]

# Блокировка рекламных доменов

DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,googleadservices.com,REJECT
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN-SUFFIX,googletagmanager.com,REJECT
DOMAIN-SUFFIX,googletagservices.com,REJECT
DOMAIN-SUFFIX,ads.yahoo.com,REJECT
DOMAIN-SUFFIX,facebook.com,DIRECT
DOMAIN-SUFFIX,google.com,DIRECT

[Script]

# HTTP запросы (блокировка рекламы)

http-request ^https?://.+.(googlevideo|youtube).com/.+ script-path=https://raw.githubusercontent.com/Lexanewmsk/shadowrocket-configuration-file/refs/heads/Shadowrocket/block_ads.js, requires-body=false, timeout=10, tag=AdBlock Request

# HTTP ответы (модификация контента)

http-response ^https?://.+.(googlevideo|youtube).com/.+ script-path=https://raw.githubusercontent.com/Lexanewmsk/shadowrocket-configuration-file/refs/heads/Shadowrocket/block_ads.js, requires-body=true, timeout=10, tag=AdBlock Response

[MITM]
hostname = *.googlevideo.com, *.youtube.com, *.google.com
