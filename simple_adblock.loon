[General]
bypass-system = false
allow-udp = true

[Rule]
HOST-SUFFIX, google.com, DIRECT
FINAL, DIRECT

[Script]
http-request ^https?:// script-path=https://raw.githubusercontent.com/Lexanewmsk/shadowrocket-configuration-file/refs/heads/Shadowrocket/block_ads.js, tag=MinimalTest, requires-body=true, timeout=10, enabled=true

[MITM]
hostname = *.google.com
