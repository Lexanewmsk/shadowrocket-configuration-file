#!name=Professional RU AdBlock для Loon
#!desc=Профессиональная блокировка рекламы для русских сайтов v3.1 (Loon версия)
#!author=Professional AdBlock Team
#!homepage=https://github.com/professional-adblock/loon-ru-adblock
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/AdBlocking.png

[Rule]
# =====================================
# DNS БЛОКИРОВКА
# =====================================

# Google реклама
DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN-SUFFIX,googleadservices.com,REJECT
DOMAIN-SUFFIX,googletagmanager.com,REJECT
DOMAIN-SUFFIX,pagead2.googlesyndication.com,REJECT

# Яндекс реклама
DOMAIN-SUFFIX,bs.yandex.ru,REJECT
DOMAIN-SUFFIX,an.yandex.ru,REJECT
DOMAIN-SUFFIX,yabs.yandex.ru,REJECT
DOMAIN-SUFFIX,adfox.ru,REJECT
DOMAIN-SUFFIX,adfox.yandex.ru,REJECT

# Дзен реклама
DOMAIN-SUFFIX,dzeninfra.ru,REJECT
DOMAIN-SUFFIX,static.dzeninfra.ru,REJECT
DOMAIN-SUFFIX,clck.dzen.ru,REJECT
DOMAIN-SUFFIX,ads.dzeninfra.ru,REJECT

# Mail.ru группа
DOMAIN-SUFFIX,go.mail.ru,REJECT
DOMAIN-SUFFIX,rs.mail.ru,REJECT
DOMAIN-SUFFIX,top.mail.ru,REJECT
DOMAIN-SUFFIX,top-fwz1.mail.ru,REJECT
DOMAIN-SUFFIX,ad.mail.ru,REJECT

# RTB платформы
DOMAIN-SUFFIX,relap.io,REJECT
DOMAIN-SUFFIX,buzzoola.com,REJECT
DOMAIN-SUFFIX,marketgid.com,REJECT
DOMAIN-SUFFIX,mgid.com,REJECT
DOMAIN-SUFFIX,smi2.net,REJECT

# Аналитика
DOMAIN-SUFFIX,mc.yandex.ru,REJECT
DOMAIN-SUFFIX,metrika.yandex.ru,REJECT
DOMAIN-SUFFIX,google-analytics.com,REJECT

# Криптомайнинг
DOMAIN-SUFFIX,coinhive.com,REJECT
DOMAIN-SUFFIX,crypto-loot.com,REJECT

# Трекинг домены
DOMAIN-KEYWORD,ads,REJECT
DOMAIN-KEYWORD,advertisement,REJECT
DOMAIN-KEYWORD,reklama,REJECT

[Script]
# =====================================
# HTTP СКРИПТЫ
# =====================================

# Основная обработка запросов для русских сайтов
http-request ^https?://.*\.ru/.* script-path=https://raw.githubusercontent.com/your-repo/loon-ru-adblock.js, tag=RU-AdBlock-Request

# Очистка HTML ответов
http-response ^https?://.*\.ru/.* script-path=https://raw.githubusercontent.com/your-repo/loon-ru-adblock.js, requires-body=true, tag=RU-AdBlock-Response

# Специальная обработка популярных сайтов
http-request ^https?://.*(yandex|vk|mail|ok|dzen)\.ru/.* script-path=https://raw.githubusercontent.com/your-repo/loon-ru-adblock.js, tag=Popular-Sites

http-response ^https?://.*(yandex|vk|mail|ok|dzen)\.ru/.* script-path=https://raw.githubusercontent.com/your-repo/loon-ru-adblock.js, requires-body=true, tag=Popular-Sites-Response

# Блокировка международной рекламы
http-request ^https?://.*\.(doubleclick|googlesyndication|googleadservices)\..*/.* script-path=https://raw.githubusercontent.com/your-repo/loon-ru-adblock.js, tag=International-Ads

# Дзен специальная обработка
http-request ^https?://.*dzen(infra)?\.ru/.* script-path=https://raw.githubusercontent.com/your-repo/loon-ru-adblock.js, tag=Dzen-AdBlock

http-response ^https?://.*dzen(infra)?\.ru/.* script-path=https://raw.githubusercontent.com/your-repo/loon-ru-adblock.js, requires-body=true, tag=Dzen-Clean

[MITM]
# =====================================
# MITM ХОСТЫ
# =====================================
hostname = *.ru,*.рф,*.yandex.ru,*.ya.ru,*.vk.com,*.mail.ru,*.ok.ru,*.dzen.ru,*.dzeninfra.ru,*.lenta.ru,*.rbc.ru,*.pikabu.ru,*.habr.com,*.avito.ru,*.ozon.ru,*.wildberries.ru,clck.dzen.ru,*.adfox.ru,*.bs.yandex.ru,*.an.yandex.ru,*.doubleclick.net,*.googlesyndication.com
